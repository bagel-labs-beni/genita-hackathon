{
  "name": "genita-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Genita server: realtime conversation core (Muse Transcribe -> Muse Spark -> Meta voice over one WebSocket), onboarding prep, accounts (Postgres).",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/main.ts",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "bench:voice": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/voice-capacity-bench.ts",
    "smoke": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/smoke.ts",
    "check:meta": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/check-meta.ts",
    "prep:e2e": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/prep-e2e.ts",
    "face:e2e": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/face-e2e.ts",
    "eval:import": "node --experimental-strip-types --no-warnings=ExperimentalWarning evals/import/run.ts",
    "db:migrate": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/db-migrate.ts",
    "handoff:e2e": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/handoff-e2e.ts",
    "accounts:e2e": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/accounts-e2e.ts",
    "smoke:interpret": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/smoke-interpret.ts",
    "eval:memory": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/eval-memory.ts",
    "check:memory": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/check-memory.ts",
    "finds:e2e": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/finds-e2e.ts",
    "product:e2e": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/product-e2e.ts",
    "watch-sim": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/watch-sim.ts"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "typescript": "5.9"
  }
}
