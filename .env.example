# Copy to .env at the repo root (git-ignored). The only required setting is your Meta API key.
MODEL_API_KEY=

# Optional for `cd genita-server && npm run local`:
# PORT=8787
# GENITA_DATA_DIR=.genita-data
# DATABASE_URL=postgres://genita:genita@127.0.0.1:5432/genita
# Default database: PGlite files in genita-server/.genita-data/db (no Docker).
# Relative data paths are resolved from genita-server/; blobs are in <data>/blobs.
